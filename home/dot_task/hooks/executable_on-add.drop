#!/usr/bin/env python3

import json
import subprocess
import sys
from html import unescape

custom_replace = [
    ("&dquot;", '"'),
    ("&open;", "["),
    ("&close;", "]"),
]


def clean_str(input):
    for before, after in custom_replace:
        input = input.replace(before, after)
    return unescape(input)


task = json.loads(sys.stdin.readline())

SKIP_REPOS = [
    "elasticsearch-php",
    "ecp-synthetics-monitors",
    "mcp-service",
    "claude-plugin",
    "agent-skills-sandbox",
    "copilot-cowork-plugin",
    "cursor-plugins",
]

if (
    "rest-api-spec" in task.get("githubtitle", "")
    and task.get("project") == "elasticsearch-specification"
):
    task["status"] = "deleted"
elif task.get("project") == "elasticsearch-specification" and "backport_" in " ".join(
    task.get("tags", [])
):
    task["status"] = "deleted"
elif task.get("project") in SKIP_REPOS:
    task["status"] = "deleted"

if task["status"] == "deleted":
    # ponytail: the task isn't in the DB until this hook returns, so purge from a detached delayed process
    subprocess.Popen(
        f"sleep 2; task rc.hooks=off rc.confirmation=off {task['uuid']} purge",
        shell=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

print(json.dumps(task))
