# vim:ft=zsh

source '/usr/share/zsh-antidote/antidote.zsh'
antidote load

# case-insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select

# tool setup
eval "$(mise activate zsh)" # mise
eval "$(direnv hook zsh)" # direnv
eval "$(starship init zsh)" #starship
source <(fzf --zsh) #fzf
export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
FZF_COLORS="bg+:-1,\
fg:gray,\
fg+:white,\
border:black,\
spinner:0,\
hl:yellow,\
header:blue,\
info:green,\
pointer:red,\
marker:blue,\
prompt:gray,\
hl+:red"
export FZF_DEFAULT_OPTS="--height 60% \
--border sharp \
--layout reverse \
--color '$FZF_COLORS' \
--prompt '∷ ' \
--pointer ▶ \
--marker ⇒"
export NNN_FIFO="/tmp/nnn.fifo" # nnn
export NNN_PLUG='p:preview-tui;a:!git annex get --jobs=4 "$nnn"*' # nnn
eval "$(atuin init zsh --disable-up-arrow)" # atuin
export EZA_COLORS="da=1;34;nnn:di=32;1:*.log=37;41;1" # eza
alias l="eza --long --header --all --icons always" # eza
[ -r /usr/share/doc/git-extras/git-extras-completion.zsh ] && source /usr/share/doc/git-extras/git-extras-completion.zsh # git-extras completion

# source external files that aren't source-controlled (or always available)
for f in $HOME/.elastic/elasticrc $HOME/.personal; do
  [ -r $f ] && source $f
done

# aliases
if [[ -z "${WAYLAND_DISPLAY}" ]]
then
  alias ccopy='xclip -selection clipboard'
  alias cpaste='xclip -selection clipboard -o'
else
  alias ccopy='wl-copy'
  alias cpaste='wl-paste'
fi
alias prettyjson='cpaste | jq | ccopy'
alias lastcommit="git rev-parse HEAD | tr -d '\n' | xclip -selection clipboard"
alias k=kubectl
alias t=timew
alias td='timew start "dev environment"'
alias te='timew start email'
alias tc='timew start clients js'
alias tp='timew start clients python'

mkcd () {
  mkdir -p "$1"
  pushd "$1"
}

# pnpm
export PNPM_HOME="/home/joshmock/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# zmx things
if command -v zmx &> /dev/null; then
  eval "$(zmx completions zsh)"
fi
zx() {
  local display
  display=$(zmx list 2>/dev/null | while IFS=$'\t' read -r name pid clients created dir; do
    name=${name#session_name=}
    pid=${pid#pid=}
    clients=${clients#clients=}
    dir=${dir#started_in=}
    printf "%-20s  pid:%-8s  clients:%-2s  %s\n" "$name" "$pid" "$clients" "$dir"
  done)

  local output query key selected session_name
  output=$({ [[ -n "$display" ]] && echo "$display"; } | fzf \
    --print-query \
    --expect=ctrl-n \
    --height=80% \
    --reverse \
    --prompt="zmx> " \
    --header="Enter: select | Ctrl-N: create new" \
    --preview='zmx history {1}' \
    --preview-window=right:60%:follow \
  )
  local rc=$?

  query=$(echo "$output" | sed -n '1p')
  key=$(echo "$output" | sed -n '2p')
  selected=$(echo "$output" | sed -n '3p')

  if [[ "$key" == "ctrl-n" && -n "$query" ]]; then
    session_name="$query"
  elif [[ $rc -eq 0 && -n "$selected" ]]; then
    session_name=$(echo "$selected" | awk '{print $1}')
  elif [[ -n "$query" ]]; then
    session_name="$query"
  else
    return 130
  fi
  zmx attach "$(echo "$session_name" | cut -d '=' -f2)"
}

alias nopi='nono run --silent --profile pi --allow-cwd -- pi'
