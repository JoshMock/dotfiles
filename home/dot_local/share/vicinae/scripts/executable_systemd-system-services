#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.exec ["/bin/bash"]
# @vicinae.title System Services
# @vicinae.description Manage a running system systemd service
# @vicinae.mode silent

service=$(systemctl list-units -t service --state running | tail -n+2 | head -n-6 | awk '{print $1}' \
  | vicinae dmenu --navigation-title "System Services" --placeholder "Select service…") || exit 0
[ -n "$service" ] || exit 0

action=$(printf 'start\nstop\nrestart' \
  | vicinae dmenu --navigation-title "System Services" --placeholder "Select action…") || exit 0
[ -n "$action" ] || exit 0

# ponytail: original pypr config had `sudo systemctl --user` which is a bug; using `sudo systemctl` for system services
sudo systemctl "$action" "$service"
