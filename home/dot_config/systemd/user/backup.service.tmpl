{{- if .backup.enabled }}
[Unit]
Description=Scheduled backups, powered by autorestic.

[Service]
Type=oneshot
ExecStart=bash -c "GOMAXPROCS=2 /usr/local/bin/autorestic --ci backup -a -- unlock && GOMAXPROCS=2 /usr/local/bin/autorestic --ci forget --prune -a -- unlock"

[Install]
WantedBy=backup.timer
{{ end }}
